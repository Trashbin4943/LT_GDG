# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Model files (대용량 파일)
# AI-Hub 모델
**/models/**/*.bin
**/models/**/pytorch_model.bin
**/models/**/model.bin
**/models/**/*.ckpt
# Checkpoint 디렉토리 패턴 (하지만 checkpoints는 별도 처리)
**/models/**/checkpoint-*/
**/models/**/checkpoint_*/
**/checkpoints/**/*.bin
**/checkpoints/**/pytorch_model.bin
**/checkpoints/**/*.ckpt
**/checkpoints/**/checkpoint*/
!**/models/**/*.json
!**/models/**/*.txt
!**/models/**/*.py
!**/models/**/__init__.py

# Base model (선택적 - 구조는 유지하되 bin 파일만 제외)
**/models/aihub/base_model/pytorch_model.bin
**/models/aihub/base_model/*.bin

# Checkpoints - 큰 파일만 제외, 설정 파일은 추적
**/models/checkpoints/**/*.safetensors
**/models/checkpoints/**/*.bin
**/models/checkpoints/**/*.model
**/models/checkpoints/**/vocab.txt
**/models/checkpoints/**/*.pt
**/models/checkpoints/**/*.pth
**/models/checkpoints/**/optimizer.pt
**/models/checkpoints/**/rng_state.pth
**/models/checkpoints/**/scaler.pt
**/models/checkpoints/**/scheduler.pt
**/models/checkpoints/**/trainer_state.json
**/models/checkpoints/**/training_args.bin
# 설정 파일은 추적 (예외 규칙)
!**/models/checkpoints/**/config.json
!**/models/checkpoints/**/tokenizer_config.json
!**/models/checkpoints/**/tokenization_*.py
!**/models/checkpoints/**/README.md

# 기타 모델 관련
*.pt
*.pth
*.h5
*.onnx
*.pb
*.tflite

# 로그 파일
*.log
*.log.*

# 임시 파일
*.tmp
*.temp
.DS_Store
Thumbs.db

