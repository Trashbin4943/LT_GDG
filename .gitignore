*_example*.json
segments_example*.json
!scripts/test_segments.json
!scripts/test_*.json

# 개발 도구
dev_tools/

# scripts 디렉토리 내 특정 파일들 제외
scripts/test_*.ps1
scripts/test_*.sh
scripts/*.ps1
scripts/*.sh
# 하지만 다음 파일들은 포함
