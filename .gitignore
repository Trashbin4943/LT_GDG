### Machine Learning Training & Model Files ###
# Model weights and checkpoints (large files)
*.bin
*.safetensors
*.pt
*.pth
*.ckpt

# Tokenizer model files (large files)
*.model
tokenizer_*.model

# Vocabulary files (large files) - Google Drive에서 다운로드
vocab.txt

# Training-related files (not needed for inference)
optimizer.pt
rng_state.pth
scaler.pt
scheduler.pt
trainer_state.json
training_args.bin

# Training output directories
checkpoint-*/
final_model/
kobert_immorality_intensity_regression/
*/checkpoint-*/
*/final_model/

# Model directories (keep base models, ignore trained/fine-tuned models)
logical_analysis/logic_classify_system/models/*/trained/
logical_analysis/logic_classify_system/models/*/fine-tuned/
logical_analysis/logic_classify_system/models/immorality_intensity/

# Model checkpoints directories (large files, should not be committed)
# But keep directory structure and small config files
logical_analysis/logic_classify_system/models/checkpoints/*/checkpoint-*/
!logical_analysis/logic_classify_system/models/checkpoints/.gitkeep
!logical_analysis/logic_classify_system/models/checkpoints/README.md

# Keep small config files for model checkpoints
!logical_analysis/logic_classify_system/models/checkpoints/*/config.json
!logical_analysis/logic_classify_system/models/checkpoints/*/tokenizer_config.json
!logical_analysis/logic_classify_system/models/checkpoints/*/tokenization_*.py

